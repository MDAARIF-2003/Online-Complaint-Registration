# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (supports local MongoDB or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/OnlineComplaintRegistration
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/OnlineComplaintRegistration?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/OnlineComplaintRegistration

# Automatic in-memory MongoDB fallback if local mongod service is not running
# Set to 'true' to allow seamless local testing/demonstration without pre-installed mongod
ALLOW_MEMORY_DB_FALLBACK=true

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_complaint_portal_2026_academic_project
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# File Uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes
UPLOAD_DIR=uploads

# Optional Email Configuration (system gracefully functions without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@complaintportal.com
