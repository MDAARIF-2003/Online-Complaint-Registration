# Persistent Database storage
server/data/*
!server/data/.gitkeep

# Logs and runtime caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
~$*
*.tmp
